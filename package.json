{
  "name": "fred-client",
  "version": "0.1.0",
  "description": "TypeScript client for FRED economic data. Works without an API key, supports historical revisions, no dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zz-plant/fred-client.git"
  },
  "homepage": "https://github.com/zz-plant/fred-client#readme",
  "bugs": "https://github.com/zz-plant/fred-client/issues",
  "author": "Kanav Jain",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fred",
    "alfred",
    "stlouisfed",
    "economic-data",
    "time-series",
    "macro",
    "api-client",
    "vintage"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  }
}
